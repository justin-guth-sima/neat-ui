{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/neat-ui",
  "allowedNonPeerDependencies": [
    "@fontsource/roboto",
    "@lucide/angular",
    "@shikijs/engine-javascript",
    "@shikijs/langs",
    "@shikijs/primitive",
    "@spartan-ng/brain",
    "class-variance-authority",
    "clsx",
    "d3-scale",
    "d3-selection",
    "d3-shape",
    "d3-zoom",
    "lucide",
    "marked",
    "tailwind-merge"
  ],
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "input": "src/styles",
      "glob": "neat-ui.css",
      "output": "styles"
    }
  ]
}
