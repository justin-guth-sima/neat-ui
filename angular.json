{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "neat-ui": {
      "projectType": "library",
      "root": "projects/neat-ui",
      "sourceRoot": "projects/neat-ui/src",
      "prefix": "neat",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/neat-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/neat-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            // Globs are relative to the source root, which the secondary entry points sit beside.
            "include": ["**/*.spec.ts", "../*/src/**/*.spec.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/neat-ui/**/*.ts", "projects/neat-ui/**/*.html"],
            "eslintConfig": "projects/neat-ui/eslint.config.js"
          }
        }
      }
    },
    "showcase": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/showcase",
      "sourceRoot": "projects/showcase/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/showcase/src/main.ts",
            "tsConfig": "projects/showcase/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/showcase/public"
              }
            ],
            "styles": [
              "projects/neat-ui/src/styles/neat-ui.css",
              "projects/showcase/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  // The primary @sima/neat-ui entry (the shell and what every page needs) is in the
                  // showcase's main bundle; the other entries load with the lazy pages that use them.
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                },
                {
                  // The kit's components carry their variants' styles (the shell, the message box's
                  // glows, the text motions), each loaded only with its entry, so a sheet past
                  // Angular's default of 4 kB is no fault of its own.
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "showcase:build:production"
            },
            "development": {
              "buildTarget": "showcase:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/showcase/**/*.ts", "projects/showcase/**/*.html"],
            "eslintConfig": "projects/showcase/eslint.config.js"
          }
        }
      }
    },
    "bench": {
      // The rendering bench (AGENTS.md "The rendering bench"): measured, never published.
      "projectType": "application",
      "schematics": {},
      "root": "projects/bench",
      "sourceRoot": "projects/bench/src",
      "prefix": "bench",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/bench/src/main.ts",
            "tsConfig": "projects/bench/tsconfig.app.json",
            "styles": ["projects/neat-ui/src/styles/neat-ui.css", "projects/bench/src/styles.css"],
            // The chat page's question shows the showcase's shelf picture, served where the
            // showcase serves it.
            "assets": [
              {
                "glob": "shelf.webp",
                "input": "projects/showcase/public/examples",
                "output": "examples"
              }
            ]
          },
          "configurations": {
            "production": {
              // Measured as an app ships (dev mode's extra change detection would skew both
              // renderers), with source maps and named chunks so the harness can map a long
              // frame's script back to the kit host or the vflow host.
              "sourceMap": true,
              "namedChunks": true,
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            // The bench's own port, the one the board serves the built bench on too.
            "port": 4300
          },
          "configurations": {
            "production": {
              "buildTarget": "bench:build:production"
            },
            "development": {
              "buildTarget": "bench:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/bench/**/*.ts", "projects/bench/**/*.html"],
            "eslintConfig": "projects/bench/eslint.config.js"
          }
        }
      }
    }
  }
}
