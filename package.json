{
  "name": "neat-ui",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve showcase",
    "build": "ng build neat-ui && npm run build:styles",
    "build:styles": "tailwindcss -i projects/neat-ui/src/styles/neat-ui.tailwind.css -o dist/neat-ui/styles/neat-ui.tailwind.css --minify",
    "build:showcase": "ng build showcase",
    "bench": "ng serve bench",
    "bench:build": "ng build bench",
    "bench:run": "node projects/bench/harness/run.mjs",
    "test": "ng test",
    "test:tools": "node --test 'tools/*.test.mjs'",
    "lint": "ng lint && stylelint \"projects/**/*.{css,scss}\" --allow-empty-input",
    "theme:emit": "tsx tools/emit-theme-css.ts",
    "helm:add": "node tools/helm-add.mjs",
    "check:dist": "node tools/check-dist.mjs",
    "pack": "npm run build && npm run check:dist && npm pack ./dist/neat-ui --pack-destination ./dist/neat-ui"
  },
  "dependencies": {
    "@angular/cdk": "~22.1.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@fontsource/roboto": "^5.3.0",
    "@lucide/angular": "^1.61.0",
    "@spartan-ng/brain": "1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "lucide": "^1.61.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "~4.3.3",
    "@tailwindcss/postcss": "~4.3.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-zoom": "^3.0.9",
    "angular-eslint": "22.6.0",
    "d3-drag": "^3.0.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "ngx-vflow": "~2.7.0",
    "playwright": "^1.64.1",
    "prettier": "^3.8.1",
    "source-map": "^0.8.0",
    "stylelint": "^17.16.0",
    "tailwindcss": "~4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
