/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@sima/neat-ui/confirm": ["./projects/neat-ui/confirm/src/public-api.ts"],
      "@sima/neat-ui/dialog": ["./projects/neat-ui/dialog/src/public-api.ts"],
      "@sima/neat-ui/input": ["./projects/neat-ui/input/src/public-api.ts"],
      "@sima/neat-ui/line-list": ["./projects/neat-ui/line-list/src/public-api.ts"],
      "@sima/neat-ui/number-field": ["./projects/neat-ui/number-field/src/public-api.ts"],
      "@sima/neat-ui/popover": ["./projects/neat-ui/popover/src/public-api.ts"],
      "@sima/neat-ui/segmented": ["./projects/neat-ui/segmented/src/public-api.ts"],
      "@sima/neat-ui/slider": ["./projects/neat-ui/slider/src/public-api.ts"],
      "@sima/neat-ui/switch": ["./projects/neat-ui/switch/src/public-api.ts"],
      "@sima/neat-ui/tabs": ["./projects/neat-ui/tabs/src/public-api.ts"],
      "@sima/neat-ui/toast": ["./projects/neat-ui/toast/src/public-api.ts"],
      "@sima/neat-ui/video": ["./projects/neat-ui/video/src/public-api.ts"],
      "@sima/neat-ui": ["./projects/neat-ui/src/public-api.ts"]
    },
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/neat-ui/tsconfig.lib.json"
    },
    {
      "path": "./projects/neat-ui/tsconfig.spec.json"
    },
    {
      "path": "./projects/showcase/tsconfig.app.json"
    },
    {
      "path": "./projects/showcase/tsconfig.spec.json"
    }
  ]
}
